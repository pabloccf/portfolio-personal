const { name, class: className } = Astro.props;
const icon = icons[name];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden="true"
  focusable="false"
  fill={icon.stroke ? 'none' : 'currentColor'}
  stroke={icon.stroke ? 'currentColor' : 'none'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icon.d}
/>
