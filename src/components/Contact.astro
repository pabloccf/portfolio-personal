---
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
import { getUI, cvPath, profile, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUI(lang).contact;
const hero = getUI(lang).hero;

const links = [
  { icon: 'mail', label: t.email, value: profile.email, href: `mailto:${profile.email}` },
  { icon: 'phone', label: t.phone, value: profile.phoneDisplay, href: `tel:${profile.phone}` },
  { icon: 'linkedin', label: 'LinkedIn', value: 'Pablo López Gosálvez', href: profile.linkedin, external: true },
  { icon: 'github', label: 'GitHub', value: `@${profile.githubUser}`, href: profile.github, external: true },
  { icon: 'user', label: t.profile, value: t.profileValue, href: profile.manfred, external: true },
  { icon: 'pin', label: t.location, value: t.locationValue },
] as const;
---

<section class="section contact" id="contact">
  <div class="container">
    <div class="contact__panel reveal">
      <div class="contact__intro">
        <SectionHead eyebrow={t.eyebrow} title={t.title} />
        <p class="contact__lead">{t.lead}</p>
        <div class="contact__actions">
          <a class="btn btn--primary" href={`mailto:${profile.email}`}>
            <Icon name="mail" />
            {profile.email}
          </a>
          <a class="btn btn--secondary" href={cvPath(lang)} download>
            <Icon name="download" />
            {hero.ctaCv}
          </a>
        </div>
      </div>

      <ul class="contact__links">
        {
          links.map((l) => {
            const Tag = 'href' in l ? 'a' : 'div';
            return (
              <li>
                <Tag
                  class="contact__link"
                  {...('href' in l ? { href: l.href } : {})}
                  {...('external' in l ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="contact__link-icon">
                    <Icon name={l.icon} />
                  </span>
                  <span class="contact__link-text">
                    <span class="contact__link-label">{l.label}</span>
                    <span class="contact__link-value">{l.value}</span>
                  </span>
                  {'external' in l && <Icon name="external" class="contact__link-ext" />}
                </Tag>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact__panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius-lg) + 8px);
    background:
      radial-gradient(36rem 20rem at 0% 0%, color-mix(in srgb, var(--accent) 14%, transparent), transparent 70%),
      radial-gradient(30rem 20rem at 100% 100%, color-mix(in srgb, var(--accent-2) 12%, transparent), transparent 70%),
      var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .contact__intro :global(.section-head) {
    margin-bottom: var(--space-4);
  }
  .contact__lead {
    font-size: var(--fs-lg);
    color: var(--text-muted);
    max-width: 44ch;
    margin-bottom: var(--space-6);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .contact__links li + li {
    border-top: 1px dashed var(--border-strong);
  }
  .contact__link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0.9rem 0.25rem;
    color: var(--text);
  }
  a.contact__link:hover {
    color: var(--text);
  }
  .contact__link-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--accent);
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }
  a.contact__link:hover .contact__link-icon {
    background: var(--gradient);
    border-color: transparent;
    color: var(--on-gradient);
  }
  .contact__link-icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .contact__link-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .contact__link-label {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .contact__link-value {
    font-weight: var(--fw-bold);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .contact__link :global(.contact__link-ext) {
    width: 1rem;
    height: 1rem;
    margin-left: auto;
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform var(--transition), color var(--transition);
  }
  a.contact__link:hover :global(.contact__link-ext) {
    color: var(--link);
    transform: translate(2px, -2px);
  }

  @media (max-width: 900px) {
    .contact__panel {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
  @media (max-width: 560px) {
    .contact__actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
