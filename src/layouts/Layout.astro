---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import ogSource from '../assets/projects/portfolio.png';
import { getUI, localePath, languages, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getUI(lang);
const site = Astro.site;
const pageUrl = new URL(localePath(lang), site).href;

// Link-preview image (LinkedIn, WhatsApp…): 1200×630 JPG, the size social networks expect
const ogImage = await getImage({ src: ogSource, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' });
const ogImageUrl = new URL(ogImage.src, site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#fbfaf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0c0b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {
      (Object.keys(languages) as Lang[]).map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localePath(l), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('es'), site).href} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Pablo López Gosálvez" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Apply the saved/system theme before first paint to avoid a flash -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
        // Safety net: if the main script never runs, don't leave .reveal content hidden
        setTimeout(() => {
          if (!window.__revealReady) root.classList.remove('js');
        }, 2500);
      })();
    </script>
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // The nav floats a few px below the top, so offset by its bottom edge plus some breathing room
      const navHeight = () => (document.querySelector<HTMLElement>('[data-nav]')?.getBoundingClientRect().bottom ?? 72) + 16;

      // ---- Smooth scroll ----
      let lenis: Lenis | null = null;
      if (!reduceMotion) {
        lenis = new Lenis({ duration: 1.15, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
        const raf = (time: number) => {
          lenis!.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="#"]');
        if (!link) return;
        const id = link.getAttribute('href')!;
        const target = id === '#' ? document.body : document.querySelector<HTMLElement>(id);
        if (!target) return;
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('nav:close'));
        if (lenis) {
          // Sections already have generous top padding, so only offset by what the nav overlaps
          const pad = parseFloat(getComputedStyle(target).paddingTop) || 0;
          lenis.scrollTo(id === '#home' ? 0 : target, { offset: pad - navHeight() - 8 });
        } else {
          target.scrollIntoView();
        }
        history.replaceState(null, '', id);
        // Move focus for keyboard and screen-reader users without jumping
        target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      });

      // ---- Reveal on scroll ----
      (window as Window & { __revealReady?: boolean }).__revealReady = true;
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window && !reduceMotion) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      } else {
        reveals.forEach((el) => el.classList.add('is-visible'));
      }

      // ---- Pointer spotlight on cards ----
      document.addEventListener(
        'pointermove',
        (e) => {
          const card = (e.target as HTMLElement).closest<HTMLElement>('.card');
          if (!card) return;
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        },
        { passive: true }
      );
    </script>
  </body>
</html>
